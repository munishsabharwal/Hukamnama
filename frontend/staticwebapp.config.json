{
  "platform": {
    "apiRuntime": "node:20"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/.auth/*"]
  },
 "auth": {
    "rolesSource": "/api/auth/getRoles",
    "identityProviders": {
      "customOpenIdConnectProviders": {
        "externalid": {
          "registration": {
            "clientIdSettingName": "EXTERNALID_CLIENT_ID",
            "clientCredential": {
              "clientSecretSettingName": "EXTERNALID_CLIENT_SECRET"
            },
            "openIdConnectConfiguration": {
              "wellKnownOpenIdConfiguration": "https://GurudwaraUsers.ciamlogin.com/f5556e86-554a-46ac-9576-ef29226843f0/v2.0/.well-known/openid-configuration"
            }
          },
          "login": {
            "scopes": [
              "openid",
              "profile",
              "email"
            ],
            "loginParameterNames": []
          }
        }
      }
    }
  },
  "routes": [
    {
      "route": "/admin",
      "allowedRoles": [
        "admin"
      ]
    },
    {
      "route": "/editor",
      "allowedRoles": [
        "editor",
        "admin"
      ]
    },
    {
      "route": "/api/admin/*",
      "allowedRoles": [
        "admin"
      ]
    },
    {
  "route": "/assets/*",
  "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/hukams/*",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ]
}
